{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "testflight": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_DISTRIBUTION": "testflight",
        "EXPO_IOS_BUNDLE_ID": "com.aoligei233666.haidaschedule"
      },
      "ios": {
        "image": "latest",
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_DISTRIBUTION": "appstore",
        "EXPO_IOS_BUNDLE_ID": "com.aoligei233666.haidaschedule"
      },
      "ios": {
        "image": "latest",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
